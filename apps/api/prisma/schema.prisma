generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Гість: лише те, чого немає в Syrve (звʼязок Telegram ↔ Syrve). Баланс не кешуємо.
model Guest {
  id              String   @id @default(uuid())
  telegramId      BigInt?  @unique @map("telegram_id") // null — гостя створено з панелі, без Telegram
  phone           String   @unique // формат +380XXXXXXXXX
  name            String
  syrveCustomerId String   @unique @map("syrve_customer_id")
  cardNumber      String?  @map("card_number")
  // Остання оброблена revision транзакцій Syrve цього гостя; null — ще не було першого проходу worker
  lastRevision    BigInt?  @map("last_revision")
  createdAt       DateTime @default(now()) @map("created_at")

  operations BonusOperation[]

  @@map("guests")
}

enum AdminRole {
  owner
  manager
}

model AdminUser {
  id           String    @id @default(uuid())
  login        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(manager)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  operations BonusOperation[]
  auditLogs  AuditLog[]

  @@map("admin_users")
}

enum BonusOperationType {
  topup
  chargeoff
}

enum BonusOperationStatus {
  pending
  done
  failed
}

// Журнал ручних операцій з панелі: хто, коли, скільки, чому.
model BonusOperation {
  id          String               @id @default(uuid())
  guestId     String?              @map("guest_id") // null, якщо гостя немає в Telegram (лише в Syrve)
  // Знімок гостя на момент операції: журнал читається без запитів до Syrve
  syrveCustomerId String           @map("syrve_customer_id")
  guestPhone      String           @map("guest_phone")
  guestName       String           @map("guest_name")
  adminId     String               @map("admin_id")
  type        BonusOperationType
  amount      Decimal              @db.Decimal(12, 2)
  reason      String
  status      BonusOperationStatus @default(pending)
  error       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  completedAt DateTime?            @map("completed_at")

  guest Guest?    @relation(fields: [guestId], references: [id])
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([syrveCustomerId, createdAt])
  @@index([createdAt])
  @@map("bonus_operations")
}

// Остання оброблена revision транзакцій Syrve (по організації).
model SyncState {
  key       String   @id
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

// Дедуплікація: одна транзакція Syrve — одне сповіщення.
model ProcessedTransaction {
  id          String   @id // id транзакції в Syrve
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_transactions")
}

enum NotificationStatus {
  pending
  sent
  failed
}

// Outbox сповіщень у Telegram.
model Notification {
  id            String             @id @default(uuid())
  transactionId String             @unique @map("transaction_id")
  telegramId    BigInt             @map("telegram_id")
  text          String
  status        NotificationStatus @default(pending)
  attempts      Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at")
  sentAt        DateTime?          @map("sent_at")

  @@index([status, createdAt])
  @@map("notifications")
}

// Журнал системних дій адміністраторів. Знімок логіну лишається, навіть якщо адміна видалено.
model AuditLog {
  id          String    @id @default(uuid())
  adminId     String?   @map("admin_id")
  adminLogin  String    @map("admin_login")
  action      String // напр. auth.login, guest.create, admin.delete
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  targetLabel String?   @map("target_label")
  details     Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_log")
}
