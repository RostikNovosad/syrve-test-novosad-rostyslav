# cp .env.example .env  — реальні значення не комітимо (репозиторій публічний)

# --- Syrve ---
# mock — імітатор (без доступу до Syrve), real — справжній Syrve Cloud API
SYRVE_MODE=mock
SYRVE_API_URL=https://api-eu.syrve.live
SYRVE_API_LOGIN=

# --- Telegram ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# --- База даних (DATABASE_URL збирається в docker-compose) ---
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loyalty

# --- Сесії адмін-панелі (openssl rand -hex 32) ---
SESSION_SECRET=

# --- Dev (Swagger /docs + /dev/* ендпоінти без авторизації; не вмикати на проді) ---
ENABLE_DEV_ROUTES=true
