# cp .env.example .env  — реальні значення не комітимо (репозиторій публічний)

# --- Syrve ---
SYRVE_API_URL=https://api-eu.syrve.live
SYRVE_API_LOGIN=

# --- Telegram ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# --- База даних ---
# У Docker DATABASE_URL збирається в docker-compose; для локального `npm run dev` розкоментуй:
# DATABASE_URL=postgresql://loyalty:change-me@localhost:5433/loyalty?schema=public
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loyalty

# --- Сесії адмін-панелі (openssl rand -hex 32) ---
SESSION_SECRET=
# Перший адміністратор (власник; створюється/оновлюється при старті). admin/admin — лише для розробки/демо, на проді задайте свій пароль
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# --- Dev (Swagger /docs + /dev/* ендпоінти без авторизації; не вмикати на проді) ---
ENABLE_DEV_ROUTES=true

# --- Сповіщення про бонуси (О6) ---
# Як часто worker опитує Syrve на нові транзакції гостів, секунд
NOTIFY_INTERVAL_SECONDS=20

# Демо-менеджер з роллю manager (необовʼязково; лише для розробки/демо — на проді не задавати)
SEED_MANAGER_LOGIN=user
SEED_MANAGER_PASSWORD=user
